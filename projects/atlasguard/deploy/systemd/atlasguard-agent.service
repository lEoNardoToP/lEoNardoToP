[Unit]
Description=AtlasGuard Linux telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlasguard
Group=atlasguard
Environment=ATLASGUARD_CONTROLLER=http://127.0.0.1:8080
ExecStart=/usr/local/bin/atlasguard agent --controller ${ATLASGUARD_CONTROLLER} --interval 5
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
